<mujoco model="so101_reach_scene">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic"/>

  <default>
    <mesh maxhullvert="128"/>
    <default class="so101">
      <joint damping="0.5" frictionloss="0.05" armature="0.01"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3" condim="3"/>
      </default>
      <default class="collision_gripper">
        <geom group="3" condim="6" friction="1.2 0.005 0.0005" solref="0.005 1" priority="1" mass="0"/>
      </default>
    </default>

    <default class="sts3215">
      <geom contype="0" conaffinity="0"/>
      <joint damping="0.60" frictionloss="0.052" armature="0.028"/>
      <position kp="250.0" kv="12.0" forcerange="-2.94 2.94"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.1 0.1 0.15" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.25 0.3" rgb2="0.15 0.18 0.22" markrgb="0.8 0.8 0.8" width="200" height="200"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="table_mat" rgba="0.85 0.85 0.88 1" specular="0.2"/>
    <material name="target_mat" rgba="0.1 0.9 0.2 0.6"/>

    <mesh file="waveshare_mounting_plate_so101_v2.stl"/>
    <mesh file="sts3215_03a_v1.stl"/>
    <mesh file="motor_holder_so101_base_v1.stl"/>
    <mesh file="wrist_roll_follower_so101_v1.stl"/>
    <mesh file="moving_jaw_so101_v1.stl"/>
    <mesh file="base_motor_holder_so101_v1.stl"/>
    <mesh file="upper_arm_so101_v1.stl"/>
    <mesh file="wrist_roll_pitch_so101_v2.stl"/>
    <mesh file="under_arm_so101_v1.stl"/>
    <mesh file="rotation_pitch_so101_v1.stl"/>
    <mesh file="motor_holder_so101_wrist_v1.stl"/>
    <mesh file="sts3215_03a_no_horn_v1.stl"/>
    <mesh file="base_so101_v2.stl"/>
    <mesh file="moving_jaw_so101_gripper_v1.stl"/>
    <mesh file="wrist_roll_follower_so101_camera_mount.stl"/>

    <material name="arm_yellow" rgba="0.95 0.75 0.1 1"/>
    <material name="servo_black" rgba="0.12 0.12 0.12 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane"/>

    <!-- Work table under the robot and task area -->
    <body name="table" pos="0.25 0.0 -0.025">
      <geom name="table_top" type="box" size="0.35 0.35 0.025" material="table_mat" friction="1.0 0.005 0.0001"/>
    </body>

    <!-- Randomized 3D Reach Target Sphere (Mocap, non-colliding visual marker) -->
    <body name="target" pos="0.25 0.0 0.15" mocap="true">
      <geom name="target_geom" type="sphere" size="0.01" material="target_mat" contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0" size="0.005" rgba="0 1 0 1"/>
    </body>

    <!-- Robot base attached to world -->
    <body name="base" pos="0 0 0" quat="1 0 0 0" childclass="so101">
      <inertial pos="0.0137179 -5.19711e-05 0.0334843" mass="0.147"
        fullinertia="0.000114686 0.000136117 0.000130364 -4.59787e-07 4.97151e-06 9.75275e-08"/>
      <geom type="mesh" class="visual" pos="-0.006365 -9.9e-05 -0.0024" quat="1 1 1 1" mesh="base_motor_holder_so101_v1" material="arm_yellow"/>
      <geom type="mesh" class="visual" pos="-0.006365 0 -0.0024" quat="1 1 1 1" mesh="base_so101_v2" material="arm_yellow"/>
      <geom type="mesh" class="visual" pos="0.0263353 0 0.0437" quat="1 0 0 0" mesh="sts3215_03a_v1" material="servo_black"/>
      <geom type="mesh" class="visual" pos="-0.0309827 -0.000199 0.0474" quat="1 1 1 1" mesh="waveshare_mounting_plate_so101_v2" material="arm_yellow"/>
      <geom type="cylinder" class="collision" pos="0 0 0.025" size="0.05 0.025"/>
      <site group="3" name="baseframe" pos="0 0 0" quat="1 0 0 0"/>

      <body name="shoulder" pos="0.0388353 0 0.0624" quat="0 0 -1 0">
        <joint axis="0 0 1" name="shoulder_pan" type="hinge" range="-1.91986 1.91986" class="sts3215"/>
        <inertial pos="-0.0307604 -1.7e-05 -0.0252713" mass="0.100006"
          fullinertia="8.3759e-05 8.10403e-05 2.39783e-05 7.55525e-08 -1.16342e-06 1.54663e-07"/>
        <geom type="mesh" class="visual" pos="-0.030399 0.000422 -0.0417" quat="1 1 1 -1" mesh="sts3215_03a_v1" material="servo_black"/>
        <geom type="box" class="collision" pos="-0.030399 0.000422 -0.0387" quat="1 1 1 -1" size="0.023 0.015 0.01"/>
        <geom type="mesh" class="visual" pos="-0.067599 -0.0001778 0.01585" quat="1 1 -1 1" mesh="motor_holder_so101_base_v1" material="arm_yellow"/>
        <geom type="box" class="collision" pos="-0.025 0 0.0" quat="1 1 -1 1" size="0.038 0.025 0.02"/>
        <geom type="mesh" class="visual" pos="0.012201 2.2e-05 0.0464" quat="1 -1 0 0" mesh="rotation_pitch_so101_v1" material="arm_yellow"/>

        <body name="upper_arm" pos="-0.0303992 -0.0182778 -0.0542" quat="1 -1 -1 -1">
          <joint axis="0 0 1" name="shoulder_lift" type="hinge" range="-1.7453293 1.7453293" class="sts3215"/>
          <inertial pos="-0.089847 -0.008382 0.018409" mass="0.103"
            fullinertia="4.08002e-05 0.000147318 0.000142487 -1.97819e-05 -4.03016e-08 8.97326e-09"/>
          <geom type="mesh" class="visual" pos="-0.11257 -0.0155 0.0187" quat="0 -1 1 0" mesh="sts3215_03a_v1" material="servo_black"/>
          <geom type="capsule" class="collision" fromto="0 0 0.018 -0.11 0 0.018" size="0.022"/>
          <geom type="mesh" class="visual" pos="-0.065085 0.012 0.0182" quat="0 1 0 0" mesh="upper_arm_so101_v1" material="arm_yellow"/>

          <body name="lower_arm" pos="-0.11257 -0.028 0" quat="1 0 0 1">
            <joint axis="0 0 1" name="elbow_flex" type="hinge" range="-1.69 1.69" class="sts3215"/>
            <inertial pos="-0.098070 0.0032438 0.018283" mass="0.104"
              fullinertia="2.87438e-05 0.000159844 0.00014529 7.41152e-06 1.26409e-06 -4.90188e-08"/>
            <geom type="mesh" class="visual" pos="-0.06485 -0.032 0.0182" quat="0 1 0 0" mesh="under_arm_so101_v1" material="arm_yellow"/>
            <geom type="capsule" class="collision" fromto="0 0 0.018 -0.12 0 0.018" size="0.02"/>
            <geom type="mesh" class="visual" pos="-0.06485 -0.032 0.018" quat="0 -1 0 0" mesh="motor_holder_so101_wrist_v1" material="arm_yellow"/>
            <geom type="mesh" class="visual" pos="-0.1224 0.0052 0.0187" quat="0 0 1 0" mesh="sts3215_03a_v1" material="servo_black"/>

            <body name="wrist" pos="-0.1349 0.0052 0" quat="1 0 0 -1">
              <joint axis="0 0 1" name="wrist_flex" type="hinge" range="-1.658063 1.658063" class="sts3215"/>
              <inertial pos="-0.000103312 -0.0386143 0.0281156" mass="0.079"
                fullinertia="3.68263e-05 2.5391e-05 2.1e-05 1.7893e-08 -5.28128e-08 3.6412e-06"/>
              <geom type="mesh" class="visual" pos="0 -0.0424 0.0306" quat="1 1 1 -1" mesh="sts3215_03a_no_horn_v1" material="servo_black"/>
              <geom type="box" class="collision" pos="0 -0.0424 0.0256" quat="1 1 1 -1" size="0.029 0.015 0.018"/>
              <geom type="mesh" class="visual" pos="0 -0.028 0.0181" quat="1 -1 -1 -1" mesh="wrist_roll_pitch_so101_v2" material="arm_yellow"/>
              <geom type="box" class="collision" pos="0 -0.02 0.0191" quat="1 -1 -1 -1" size="0.027 0.01 0.03"/>

              <body name="gripper" pos="0 -0.0611 0.0181" quat="0.0172091 -0.0172091 0.706897 0.706897">
                <joint axis="0 0 1" name="wrist_roll" type="hinge" range="-2.7438473 2.8412063" class="sts3215"/>
                <inertial pos="0.000214 0.000245 -0.025187" mass="0.087"
                  fullinertia="2.75087e-05 4.33657e-05 3.45059e-05 -3.35241e-07 -5.7352e-06 -5.17847e-08"/>
                <geom type="mesh" class="visual" pos="0.0077 0.0001 -0.0234" quat="1 -1 0 0" mesh="sts3215_03a_v1" material="servo_black"/>
                <geom type="mesh" class="visual" pos="0 -0.000218 0.00095" quat="0 1 0 0" mesh="wrist_roll_follower_so101_v1" material="arm_yellow"/>
                
                <geom name="fixed_jaw_base" class="collision_gripper" type="box" size="0.025 0.014 0.015" pos="-0.0025 0 -0.022"/>
                <geom name="fixed_jaw_mid" class="collision_gripper" type="box" size="0.008 0.012 0.018" pos="-0.012 0 -0.06"/>
                <geom name="fixed_jaw_tip" class="collision_gripper" type="box" size="0.006 0.010 0.015" pos="-0.008 0 -0.095"/>
                
                <site group="3" name="gripperframe" pos="0.0 -0.000218 -0.098127" quat="1 0 1 0"/>
                <site group="3" name="ee_center" pos="-0.005 0.0 -0.095" size="0.005" rgba="1 0 0 0.8"/>

                <body name="moving_jaw_so101_v1" pos="0.0202 0.0188 -0.0234" quat="1 1 0 0">
                  <joint axis="0 0 1" name="gripper" type="hinge" range="-0.174533 1.7453292" class="sts3215"/>
                  <inertial pos="-0.001575 -0.0300244 0.0192755" mass="0.012"
                    fullinertia="6.61427e-06 1.89032e-06 5.28738e-06 -3.19807e-07 -5.90717e-09 -1.09945e-07"/>
                  <geom type="mesh" class="visual" pos="0 0 0.0189" quat="1 0 0 0" mesh="moving_jaw_so101_v1" material="arm_yellow"/>
                  <geom name="moving_jaw_base" class="collision_gripper" type="box" size="0.01 0.01 0.015" pos="0.0 -0.013 0.019"/>
                  <geom name="moving_jaw_mid" class="collision_gripper" type="box" size="0.008 0.012 0.018" pos="-0.008 -0.045 0.019"/>
                  <geom name="moving_jaw_tip" class="collision_gripper" type="box" size="0.006 0.010 0.015" pos="-0.011 -0.075 0.019"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base" body2="shoulder"/>
    <exclude body1="shoulder" body2="upper_arm"/>
    <exclude body1="upper_arm" body2="lower_arm"/>
    <exclude body1="lower_arm" body2="wrist"/>
    <exclude body1="wrist" body2="gripper"/>
    <exclude body1="gripper" body2="moving_jaw_so101_v1"/>
  </contact>

  <actuator>
    <position class="sts3215" name="shoulder_pan" joint="shoulder_pan" ctrlrange="-1.91986 1.91986"/>
    <position class="sts3215" name="shoulder_lift" joint="shoulder_lift" ctrlrange="-1.74533 1.74533"/>
    <position class="sts3215" name="elbow_flex" joint="elbow_flex" ctrlrange="-1.69 1.69"/>
    <position class="sts3215" name="wrist_flex" joint="wrist_flex" ctrlrange="-1.65806 1.65806"/>
    <position class="sts3215" name="wrist_roll" joint="wrist_roll" ctrlrange="-2.74385 2.84121"/>
    <position class="sts3215" name="gripper" joint="gripper" ctrlrange="-0.17453 1.74533"/>
  </actuator>
</mujoco>